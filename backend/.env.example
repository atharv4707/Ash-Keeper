# AshKeeper Backend — Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:2006@localhost:5432/ashkeeper
# JWT secret — change this to a long random string in production
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production-min-32-chars

# JWT algorithm
ALGORITHM=HS256

# Token expiry in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS origins (JSON array of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
